{
  "name": "opencontainer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An open-source WebContainer: run Node-style projects fully client-side in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "node server.mjs",
    "verify": "node scripts/verify-node.mjs",
    "build:kernel": "wasm-pack build packages/kernel --target web --out-dir pkg",
    "build:kernel:node": "wasm-pack build packages/kernel --target nodejs --out-dir pkg-node",
    "build:codec": "wasm-pack build packages/codec --target web --out-dir pkg",
    "build:codec:node": "wasm-pack build packages/codec --target nodejs --out-dir pkg-node",
    "build:crypto": "wasm-pack build packages/crypto --target web --out-dir pkg",
    "build:crypto:node": "wasm-pack build packages/crypto --target nodejs --out-dir pkg-node",
    "build": "npm run build:kernel && npm run build:kernel:node && npm run build:codec && npm run build:codec:node && npm run build:crypto && npm run build:crypto:node"
  }
}
