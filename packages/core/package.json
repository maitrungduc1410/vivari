{
  "name": "@vivari/core",
  "version": "1.0.0",
  "description": "Run Node, Bun and Python projects fully client-side in the browser: Node's real lib/, the real npm/yarn/pnpm, and real CPython. The framework-agnostic Vivari WebContainer SDK.",
  "keywords": [
    "webcontainer",
    "vivari",
    "browser",
    "nodejs",
    "bun",
    "python",
    "nextjs",
    "wasm",
    "webassembly",
    "sandbox",
    "runtime"
  ],
  "license": "MIT",
  "author": "Duc Trung Mai <maitrungduc1410@gmail.com>",
  "homepage": "https://vivari.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maitrungduc1410/vivari.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/maitrungduc1410/vivari/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.wasm"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:workers": "tsc -p tsconfig.workers.json"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}