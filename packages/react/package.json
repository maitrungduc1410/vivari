{
  "name": "@vivari/react",
  "version": "0.0.1",
  "description": "React bindings for Vivari — an embeddable browser-native WebContainer.",
  "keywords": [
    "webcontainer",
    "vivari",
    "react",
    "browser",
    "nodejs",
    "sandbox"
  ],
  "license": "MIT",
  "author": "Duc Trung Mai <maitrungduc1410@gmail.com>",
  "homepage": "https://vivari.jamesisme.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maitrungduc1410/vivari.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/maitrungduc1410/vivari/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@vivari/core": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}